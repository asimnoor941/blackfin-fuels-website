---
/**
 * The five city pages as a numbered route list (north to south), each with its
 * zone schedule and minimum. The page being viewed is marked "You are here".
 *
 *   <CityLinks current="cape-coral" />
 */
import Icon from '../Icon.astro';
import { cities } from '../../data/site';
import { zones } from './zones';

interface Props {
  /** Slug of the page being viewed. */
  current: string;
}

const { current } = Astro.props;

const note = (slug: string) => {
  const z = zones[slug];
  if (!z) return '';
  return z.minimum ? `${z.schedule} · ${z.minimum} gal min` : z.schedule;
};
---

<nav class="cl" aria-label="Service areas on our route">
  <ol class="cl__list" role="list" data-reveal-group>
    {
      cities.map((city, i) => {
        const here = city.slug === current;
        return (
          <li data-reveal>
            <a class:list={['cl__link', { 'is-here': here }]} href={`/${city.slug}/`} aria-current={here ? 'page' : undefined}>
              <span class="cl__num numeral">0{i + 1}</span>
              <span class="cl__name">{city.name}</span>
              <span class="cl__note">{here ? 'You are here' : note(city.slug)}</span>
              <Icon name="arrow-up-right" size={18} class="cl__arrow" />
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .cl__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .cl__link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    grid-template-areas:
      'num name icon'
      'num note icon';
    align-items: center;
    column-gap: 1rem;
    min-height: 5.25rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .cl__link:hover,
  .cl__link:focus-visible {
    background: var(--navy-600);
    border-color: var(--accent);
  }

  .cl__link.is-here {
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(95 175 255 / 0.28), transparent 60%),
      linear-gradient(140deg, #134072, #0c2a4a 70%);
    border-color: var(--line-strong);
  }

  .cl__num {
    grid-area: num;
    font-size: var(--step-2);
    color: var(--accent);
  }

  .cl__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--text);
  }

  .cl__note {
    grid-area: note;
    margin-top: 0.2rem;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .is-here .cl__note {
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .cl__link :global(.cl__arrow) {
    grid-area: icon;
    color: var(--text-faint);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .cl__link:hover :global(.cl__arrow),
  .cl__link:focus-visible :global(.cl__arrow) {
    color: var(--accent);
    transform: translate(3px, -3px);
  }
</style>
