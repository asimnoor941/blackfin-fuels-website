---
/**
 * "How delivery works here" strip for a city page: the four delivery steps
 * (same wording as the home page) as cards that hinge up in turn on scroll,
 * plus links to the full delivery and service-area pages.
 * Renders its own <section>; place it directly inside the page.
 *
 *   <CityDelivery city="Cape Coral" />
 */
import Button from '../Button.astro';
import Icon from '../Icon.astro';

interface Props {
  city: string;
}

const { city } = Astro.props;

const steps = [
  {
    title: 'Request Fuel',
    text: 'Order directly from our app, give us a call or send us a text with your dock location, gallons needed, and preferred delivery window.',
    icon: 'smartphone',
  },
  {
    title: 'We Keep You Updated',
    text: 'We’ll text you what day you are in the route with a two-hour delivery window, then send another text when you’re the next stop on our route.',
    icon: 'message',
  },
  {
    title: 'We Fuel Your Boat',
    text: 'Our trained, insured driver fuels your boat dockside. You receive your receipt and invoice after delivery.',
    icon: 'drop',
  },
  {
    title: 'Easy Payment',
    text: 'Receive your invoice after delivery. Pay securely by ACH, credit card, check, or Zelle.',
    icon: 'card',
  },
] as const;
---

<section class="cd" aria-labelledby="cd-title">
  <div class="container">
    <header class="cd__head">
      <div data-reveal>
        <p class="eyebrow">How delivery works in {city}</p>
        <h2 id="cd-title">Four steps. Fuel at your dock.</h2>
      </div>
      <div class="cd__aside" data-reveal>
        <p class="lede">No marina lines. No fuel docks. Just reliable fuel delivered directly to your boat.</p>
        <div class="cluster">
          <Button href="/fuel-delivery/" variant="ghost">How delivery works</Button>
          <Button href="/service-areas/" variant="link">All service areas</Button>
        </div>
      </div>
    </header>

    <ol class="cd__steps" role="list" data-3d="flip" data-3d-strength="0.6">
      {
        steps.map((step, i) => (
          <li class="cd__step">
            <div class="cd__top">
              <span class="cd__num numeral">0{i + 1}</span>
              <span class="cd__icon">
                <Icon name={step.icon} size={22} />
              </span>
            </div>
            <h3 class="cd__title">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cd {
    position: relative;
    z-index: var(--z-content);
    padding-block: var(--section-pad);
    background: linear-gradient(180deg, var(--navy-800), var(--navy-900));
    border-block: 1px solid var(--line);
  }

  .cd__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .cd__head > div > :global(* + *) {
    margin-top: 1.1rem;
  }

  .cd__head h2 {
    max-width: 14ch;
  }

  .cd__aside :global(.cluster) {
    margin-top: 1.75rem;
  }

  @media (min-width: 60em) {
    .cd__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }
  }

  .cd__steps {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  @media (min-width: 40em) {
    .cd__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62em) {
    .cd__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cd__step {
    padding: clamp(1.4rem, 1rem + 1vw, 2rem);
    background: linear-gradient(170deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015)), var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }

  .cd__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .cd__num {
    font-size: var(--step-4);
    color: var(--accent);
  }

  .cd__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--accent);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .cd__title {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .cd__step p {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--text-muted);
  }
</style>
