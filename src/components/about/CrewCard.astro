---
/**
 * One crew member on the About page: a card with a gradient surface, a
 * portrait (or a monogram tile when there is no photo), an outlined index
 * numeral, the name and the bio in the default slot.
 *
 *   <CrewCard index="02" name="Tyrelle" photo={tyrelle} alt="..." position="48% 30%">Bio...</CrewCard>
 *   <CrewCard index="04" name="Jessica">Bio...</CrewCard>      (monogram tile)
 *
 * position  object-position for the portrait crop.
 * monogram  Letter on the monogram tile. Defaults to the first letter of the name.
 */
import type { ImageMetadata } from 'astro';
import Photo from '../Photo.astro';
import Contours from '../Contours.astro';

interface Props {
  name: string;
  index?: string;
  photo?: ImageMetadata;
  alt?: string;
  position?: string;
  monogram?: string;
}

const { name, index, photo, alt = '', position = '50% 30%', monogram } = Astro.props;
const letter = monogram ?? name.trim().charAt(0);
---

<article class="crew-card">
  <div class="crew-card__media">
    {
      photo ? (
        <Photo
          src={photo}
          alt={alt}
          ratio="4 / 5"
          position={position}
          sizes="(min-width: 68em) 30vw, (min-width: 44em) 46vw, 100vw"
          widths={[360, 480, 720, 960]}
          reveal={false}
        />
      ) : (
        <div class="crew-card__monogram" aria-hidden="true">
          <Contours class="crew-card__lines" lines={9} />
          <span class="crew-card__ring">
            <span class="crew-card__letter numeral">{letter}</span>
          </span>
        </div>
      )
    }
    {
      index && (
        <span class="crew-card__index numeral" aria-hidden="true">
          {index}
        </span>
      )
    }
  </div>
  <div class="crew-card__body">
    <h3 class="crew-card__name">{name}</h3>
    <p class="crew-card__bio"><slot /></p>
  </div>
</article>

<style>
  .crew-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: linear-gradient(170deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015)), var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }

  .crew-card__media {
    position: relative;
    margin: 0.6rem 0.6rem 0;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 6px);
  }

  /* single column on phones: a squarer crop keeps each card shorter */
  @media (max-width: 43.99em) {
    .crew-card__media :global(.photo__media),
    .crew-card__monogram {
      aspect-ratio: 1 / 1 !important;
    }
  }

  .crew-card__index {
    position: absolute;
    right: 0.9rem;
    bottom: 0.4rem;
    font-size: clamp(2.87rem, 1.88rem + 2.04vw, 3.5rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.75);
    text-shadow: 0 4px 24px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  .crew-card__body {
    flex: 1;
    padding: 1.5rem clamp(1.25rem, 1rem + 1vw, 1.75rem) 1.9rem;
  }

  .crew-card__name {
    font-size: var(--step-3);
  }

  .crew-card__bio {
    margin-top: 0.85rem;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .crew-card__monogram {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background:
      radial-gradient(80% 60% at 50% 0%, rgb(55 138 221 / 0.3), transparent 70%),
      linear-gradient(180deg, var(--navy-600), var(--navy-900));
  }

  .crew-card__monogram :global(.crew-card__lines) {
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    opacity: 0.7;
  }

  .crew-card__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 46%;
    aspect-ratio: 1;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: rgb(9 23 36 / 0.55);
    box-shadow: 0 0 0 0.6rem rgb(95 175 255 / 0.06);
  }

  .crew-card__letter {
    font-size: clamp(2.87rem, 1.5rem + 4.08vw, 3.85rem);
    color: var(--accent);
    /* Anton sits high in its box; nudge it to the optical centre. */
    transform: translateY(0.04em);
  }
</style>

