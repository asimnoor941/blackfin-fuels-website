---
/**
 * The six delivery zones as an executive timetable: one hairline-ruled row
 * per zone with an outlined index numeral, the zone name, description, tags,
 * schedule, minimum and links to the city pages.
 *
 *   <ZoneLedger zones={zones} />
 *
 * Each row has id `zone-<id>` so the route diagram can link to it.
 * Rows fade in on scroll (data-reveal); no 3D here, the map carries that.
 */
import Icon from '../Icon.astro';

export interface Zone {
  id: string;
  name: string;
  schedule: string;
  minimum: string;
  text: string;
  tags: string[];
  links: { label: string; href: string }[];
  frequent?: boolean;
}

interface Props {
  zones: Zone[];
}

const { zones } = Astro.props;
---

<ol class="zones" role="list" data-reveal-group>
  {
    zones.map((zone, i) => {
      const [amount, ...rest] = zone.minimum.split(' ');
      return (
        <li class:list={['zone', { 'zone--frequent': zone.frequent }]} id={`zone-${zone.id}`} data-reveal>
          <p class="zone__index numeral" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </p>

          <div class="zone__main">
            <h3 class="zone__name">{zone.name}</h3>
            <p class="zone__text">{zone.text}</p>
            <ul class="zone__tags" role="list">
              {zone.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </div>

          <dl class="zone__facts">
            <div class="zone__fact">
              <dt>Minimum</dt>
              <dd>
                <span class="numeral zone__amount">{amount}</span>
                <span class="zone__unit">{rest.join(' ')}</span>
              </dd>
            </div>
            <div class="zone__fact">
              <dt>Schedule</dt>
              <dd class="zone__schedule">
                <span class:list={['zone__pip', { 'zone__pip--ring': zone.frequent }]} aria-hidden="true" />
                {zone.schedule}
              </dd>
            </div>
          </dl>

          <p class="zone__links">
            {zone.links.map((link) => (
              <a class="zone__link" href={link.href}>
                <span>{link.label}</span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            ))}
          </p>
        </li>
      );
    })
  }
</ol>

<style>
  .zones {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .zone {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.4rem;
    padding-block: clamp(2rem, 1.4rem + 2vw, 3.25rem);
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .zone::before {
    content: '';
    position: absolute;
    inset: -1px auto -1px 0;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .zone:target::before,
  .zone:hover::before {
    opacity: 1;
  }

  .zone:target .zone__name {
    color: var(--accent);
  }

  .zone__index {
    font-size: clamp(2.79rem, 1.5rem + 3.4vw, 4.55rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    transition: -webkit-text-stroke-color var(--dur-2) var(--ease-out);
  }

  .zone:hover .zone__index,
  .zone:target .zone__index {
    -webkit-text-stroke-color: var(--accent);
  }

  .zone__name {
    font-size: var(--step-3);
    line-height: 1;
  }

  .zone__text {
    margin-top: 1rem;
    max-width: 40em;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .zone__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .zone__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
  }

  .zone__fact {
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .zone__facts dt {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .zone__facts dd {
    margin: 0.5rem 0 0;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .zone__amount {
    font-size: var(--step-4);
    line-height: 0.9;
  }

  .zone__unit {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .zone__schedule {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .zone--frequent .zone__schedule {
    color: var(--accent-strong);
  }

  .zone__pip {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--accent);
    border-radius: 50%;
  }

  .zone__pip--ring {
    margin-inline: 4px;
    box-shadow:
      0 0 0 3px var(--navy-900),
      0 0 0 4px rgb(95 175 255 / 0.55);
  }

  .zone__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .zone__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.1rem;
    white-space: nowrap;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    background: rgb(95 175 255 / 0.06);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .zone__link :global(svg) {
    color: var(--accent);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .zone__link:hover {
    background: var(--navy-600);
    border-color: var(--accent);
  }

  .zone__link:hover :global(svg) {
    transform: translate(3px, -3px);
  }

  @media (min-width: 40em) {
    .zone {
      grid-template-columns: 6rem minmax(0, 1fr);
      column-gap: 1.5rem;
    }

    .zone__index {
      grid-row: 1 / span 3;
    }
  }

  @media (min-width: 64em) {
    .zone {
      grid-template-columns: 8.5rem minmax(0, 1fr) minmax(0, 14rem) 13.5rem;
      column-gap: clamp(1.5rem, 2.5vw, 3rem);
      align-items: start;
      padding-left: 1.25rem;
    }

    .zone__index {
      grid-row: auto;
    }

    .zone__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .zone__links {
      flex-direction: column;
      align-items: stretch;
    }

    .zone__link {
      justify-content: space-between;
    }
  }
</style>
