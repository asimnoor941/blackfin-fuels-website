---
/**
 * The three ways to reach the team (call, text, email) as large tap targets.
 * Phone and email always come from src/data/site.ts.
 *
 *   <ContactMethods />                 stacked hairline rows (contact page)
 *   <ContactMethods layout="row" />    three across on wide screens
 *   <ContactMethods layout="cards" />  three gradient cards (FAQ page)
 *
 * reveal  false when the list is on screen at load (no scroll-in animation).
 * flip    true to hinge the cards up one by one on scroll (data-3d="flip");
 *         replaces the reveal.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import { contact } from '../../data/site';

interface Props {
  layout?: 'list' | 'row' | 'cards';
  reveal?: boolean;
  flip?: boolean;
  class?: string;
}

const { layout = 'list', reveal = true, flip = false, class: className } = Astro.props;
const itemReveal = reveal && !flip ? '' : undefined;

const methods: { label: string; value: string; href: string; icon: IconName; kind: string }[] = [
  { label: 'Phone', value: contact.phoneDisplay, href: contact.phoneHref, icon: 'phone', kind: 'call' },
  { label: 'Text', value: contact.phoneDisplay, href: contact.smsHref, icon: 'message', kind: 'text' },
  { label: 'Email', value: contact.email, href: contact.emailHref, icon: 'mail', kind: 'email' },
];
---

<ul
  class:list={['methods', `methods--${layout}`, className]}
  role="list"
  data-reveal-group={itemReveal}
  data-3d={flip ? 'flip' : undefined}
  data-3d-strength={flip ? '0.55' : undefined}
>
  {
    methods.map((method) => (
      <li data-reveal={itemReveal}>
        <a class:list={['method', `method--${method.kind}`]} href={method.href}>
          <span class="method__icon" aria-hidden="true">
            <Icon name={method.icon} size={22} />
          </span>
          <span class="method__text">
            <span class="method__label">{method.label}</span>
            <span class="method__value">{method.value}</span>
          </span>
          <span class="method__arrow" aria-hidden="true">
            <Icon name="arrow-up-right" size={22} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .methods {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .method {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.6rem + 1.4vw, 1.75rem);
    min-height: 5.5rem;
    padding-block: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    padding-inline: 0.25rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition:
      background-color var(--dur-2) var(--ease-out),
      padding var(--dur-2) var(--ease-out);
  }

  .method__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    color: var(--accent);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .method__text {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    flex: 1;
  }

  .method__label {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .method__value {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.75rem + 2.3vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: 0.012em;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .method--email .method__value {
    font-size: clamp(1.05rem, 0.6rem + 2vw, 2.4rem);
  }

  .method__arrow {
    flex: none;
    color: var(--text-faint);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .method:hover,
  .method:focus-visible {
    background: rgb(95 175 255 / 0.06);
    padding-inline: 0.9rem;
  }

  .method:hover .method__icon,
  .method:focus-visible .method__icon {
    background: var(--accent);
    color: var(--on-accent);
  }

  .method:hover .method__arrow,
  .method:focus-visible .method__arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  @media (max-width: 24em) {
    .method__arrow {
      display: none;
    }
  }

  /* Three across: used as a closing strip under other content. */
  /* Cards: three gradient surfaces, as on the home page. */
  .methods--cards {
    gap: 1rem;
    border-top: 0;
  }

  .methods--cards .method {
    height: 100%;
    min-height: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.25rem;
    padding: clamp(1.4rem, 1rem + 1vw, 2rem);
    background: linear-gradient(170deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015)), var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }

  .methods--cards .method__text {
    flex: none;
    width: 100%;
  }

  .methods--cards .method__value {
    font-size: var(--step-2);
  }

  .methods--cards .method--email .method__value {
    font-size: var(--step-1);
  }

  .methods--cards .method__arrow {
    position: absolute;
    top: clamp(1.4rem, 1rem + 1vw, 2rem);
    right: clamp(1.4rem, 1rem + 1vw, 2rem);
  }

  .methods--cards .method {
    position: relative;
  }

  .methods--cards .method:hover,
  .methods--cards .method:focus-visible {
    padding-inline: clamp(1.4rem, 1rem + 1vw, 2rem);
    background: linear-gradient(170deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02)), var(--navy-600);
    border-color: var(--accent);
  }

  @media (min-width: 48em) {
    .methods--cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 24em) {
    .methods--cards .method__arrow {
      display: block;
    }
  }

  @media (min-width: 62em) {
    .methods--row {
      grid-template-columns: repeat(2, auto) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3.5rem);
    }

    .methods--row .method {
      height: 100%;
    }

    .methods--row .method__value {
      font-size: var(--step-2);
      white-space: nowrap;
    }

    .methods--row .method__arrow {
      display: none;
    }
  }
</style>
