<script>
  import { track } from '../scripts/track';
  import { money, paintPrices, type Price } from '../scripts/price';
  import { orderTerms } from '../data/site';

  let livePrice: Price | null = null;
  const totals: Array<() => void> = [];
  paintPrices().then((price) => {
    livePrice = price;
    totals.forEach((update) => update());
  });

  type Errors = Record<string, string>;

  const PHONE = /^[+()\-.\s\d]{7,}$/;
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const MAX = 9999;

  const isoToday = () => {
    const now = new Date();
    return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  };
  const isWeekend = (iso: string) => {
    const day = new Date(`${iso}T12:00:00`).getDay();
    return day === 0 || day === 6;
  };
  const prettyDate = (iso: string) =>
    new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });

  document.querySelectorAll<HTMLFormElement>('form[data-order-form]').forEach((form) => {
    const root = form.parentElement!;
    const sent = root.querySelector<HTMLElement>('[data-form-sent]');
    const confirm = root.querySelector<HTMLDialogElement>('[data-order-confirm]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const min = Number(form.dataset.min ?? 75);
    const startedAt = Date.now();
    let started = false;

    const el = <T extends Element>(selector: string) => form.querySelector<T>(selector)!;
    const fillGuess = el<HTMLInputElement>('input[name="fillGuess"]');
    const fillUnknown = el<HTMLInputElement>('input[name="fillUnknown"]');
    const exact = el<HTMLInputElement>('input[name="exactGallons"]');
    const date = el<HTMLInputElement>('input[name="date"]');
    const subFill = el<HTMLElement>('[data-amount-sub="fill"]');
    const subExact = el<HTMLElement>('[data-amount-sub="exact"]');
    const panels = Array.from(form.querySelectorAll<HTMLElement>('[data-panel]'));
    const termBoxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="terms"]'));
    const termsSub = el<HTMLElement>('[data-terms-sub]');

    const targets: Record<string, () => HTMLElement | null> = {
      fillType: () => (fillType() === 'fill' ? fillGuess : fillType() === 'exact' ? exact : form.querySelector('input[name="fillType"]')),
      terms: () => termBoxes.find((box) => !box.checked) ?? null,
    };
    const fieldFor = (name: string) => targets[name]?.() ?? form.querySelector<HTMLElement>(`[name="${name}"]`);
    const errorFor = (name: string) => form.querySelector<HTMLElement>(`[id$="-${name}-error"]`);

    const fillType = () => (new FormData(form).get('fillType') as 'fill' | 'exact' | null) ?? null;
    const dateType = () => String(new FormData(form).get('dateType') ?? 'asap') as 'asap' | 'before' | 'on';
    const exactValue = () => Math.round(Number(exact.value));
    const guessValue = () => (fillUnknown.checked ? 0 : Math.round(Number(fillGuess.value)) || 0);

    // Amount: show the panel for the chosen card and the app's card sub-text.
    const syncAmount = () => {
      const type = fillType();
      panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== type));
      const guess = guessValue();
      subFill.textContent =
        type === 'fill' ? (fillUnknown.checked ? 'measured at the pump' : guess ? `about ${guess} gal` : 'we fill the tank') : 'we fill the tank';
      subExact.textContent = type === 'exact' && exactValue() >= min ? `${exactValue()} gal only` : 'not a fill';
    };
    fillUnknown.addEventListener('change', () => {
      if (fillUnknown.checked) fillGuess.value = '';
    });
    fillGuess.addEventListener('input', () => {
      if (fillGuess.value) fillUnknown.checked = false;
    });
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((stepButton) =>
      stepButton.addEventListener('click', () => {
        const next = (exactValue() || min) + Number(stepButton.dataset.step);
        exact.value = String(Math.min(MAX, Math.max(min, next)));
        clearError('fillType');
        syncAmount();
        updateTotal();
      }),
    );
    // Like the app, a number under the minimum snaps up to it when the field is left.
    exact.addEventListener('change', () => {
      if (exact.value && exactValue() < min) exact.value = String(min);
      if (exactValue() > MAX) exact.value = String(MAX);
      syncAmount();
      updateTotal();
    });

    // When: ASAP needs no date; the dated choices show the date, "on" also offers "sooner is OK".
    const whenAsap = el<HTMLElement>('[data-when-asap]');
    const whenDate = el<HTMLElement>('[data-when-date]');
    const whenSooner = el<HTMLElement>('[data-when-sooner]');
    const syncWhen = () => {
      const type = dateType();
      whenAsap.hidden = type !== 'asap';
      whenDate.hidden = type === 'asap';
      whenSooner.hidden = type !== 'on';
      if (type === 'asap') clearError('date');
    };
    date.min = isoToday();

    // Checklist: same wording as the app, all items must be ticked.
    const syncTerms = () => {
      const all = termBoxes.every((box) => box.checked);
      termsSub.textContent = all ? 'All confirmed, thank you.' : 'Please confirm each item below.';
      if (all) clearError('terms');
    };

    // Estimated total = live price x gallons (delivery is included).
    const totalEl = form.querySelector<HTMLElement>('[data-total]');
    function updateTotal() {
      if (!totalEl || !livePrice) return;
      const type = fillType();
      const gallons = type === 'exact' ? exactValue() : type === 'fill' ? guessValue() : 0;
      if (!type) totalEl.textContent = 'Choose an amount';
      else if (type === 'fill' && !gallons) totalEl.textContent = 'On site';
      else if (type === 'exact' && gallons < min) totalEl.textContent = `Min. ${min} gal`;
      else totalEl.textContent = '~' + money(gallons * livePrice.price);
    }
    totals.push(updateTotal);

    form.addEventListener('change', () => {
      syncAmount();
      syncWhen();
      syncTerms();
      updateTotal();
    });
    form.addEventListener('input', (event) => {
      syncAmount();
      updateTotal();
      if (!started) {
        started = true;
        track('order_form_start', { placement: form.dataset.placement ?? '' });
      }
      const target = event.target as HTMLInputElement;
      if (['fillType', 'fillGuess', 'fillUnknown', 'exactGallons'].includes(target.name)) clearError('fillType');
      else if (target.name && target.getAttribute('aria-invalid') === 'true') clearError(target.name);
    });

    // Prefill from the "Need fuel?" pop-up (?area=...&amount=fill|exact).
    const params = new URLSearchParams(window.location.search);
    const areaParam = params.get('area');
    const amountParam = params.get('amount');
    if (areaParam || amountParam) {
      const area = form.querySelector<HTMLSelectElement>('select[name="area"]');
      if (area && areaParam && Array.from(area.options).some((o) => o.value === areaParam)) area.value = areaParam;
      const card = form.querySelector<HTMLInputElement>(`input[name="fillType"][value="${amountParam === 'exact' ? 'exact' : 'fill'}"]`);
      if (card && amountParam) card.checked = true;
      const gallonsParam = Math.round(Number(params.get('gallons')));
      if (amountParam === 'exact' && gallonsParam >= min && gallonsParam <= MAX) exact.value = String(gallonsParam);
      requestAnimationFrame(() => {
        form.scrollIntoView({ block: 'start' });
        (amountParam ? (amountParam === 'exact' ? exact : fillGuess) : form.querySelector<HTMLInputElement>('input[name="fillType"]'))?.focus({
          preventScroll: true,
        });
      });
    }
    syncAmount();
    syncWhen();
    syncTerms();

    function setError(name: string, message: string): void {
      const field = fieldFor(name);
      const error = errorFor(name);
      field?.setAttribute('aria-invalid', 'true');
      if (field && error) field.setAttribute('aria-describedby', error.id);
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    }

    function clearError(name: string): void {
      form.querySelectorAll(name === 'fillType' ? '[name="fillGuess"], [name="exactGallons"], [name="fillType"]' : name === 'terms' ? '[name="terms"]' : `[name="${name}"]`).forEach(
        (field) => field.removeAttribute('aria-invalid'),
      );
      const error = errorFor(name);
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
    }

    function collect() {
      const data = new FormData(form);
      const text = (key: string) => String(data.get(key) ?? '').trim();
      const type = fillType();
      const name = text('name');
      const [firstName = '', ...rest] = name.split(/\s+/);
      const gallons = type === 'exact' ? exactValue() : type === 'fill' ? guessValue() || null : null;
      const when = dateType();
      const ticked = termBoxes.filter((box) => box.checked).map((box) => orderTerms[Number(box.value)]);
      return {
        source: 'web',
        fuelType: 'rec90',
        name,
        firstName,
        lastName: rest.join(' '),
        phone: text('phone'),
        email: text('email'),
        address: text('address'),
        area: text('area'),
        boat: {
          type: text('boatType') || 'Boat',
          tanks: Number(text('tanks')) || 1,
          tankGallons: Number(text('tankGallons')) || null,
          name: text('boatName'),
        },
        fillType: type,
        /** Exact: the gallons to deliver. Fill: the customer's guess, or null for "I don't know". */
        gallons,
        dateType: when,
        requestedDate: when === 'asap' ? '' : text('date'),
        okSooner: when === 'before' ? true : when === 'on' ? data.get('okSooner') === 'yes' : true,
        notes: text('notes'),
        termsAck: { items: ticked, at: new Date().toISOString() },
        company: text('company'),
        placement: form.dataset.placement ?? '',
        page: window.location.pathname,
        elapsedMs: Date.now() - startedAt,
        quotedPrice: livePrice && !livePrice.sample ? livePrice.price : null,
        quotedAt: livePrice && !livePrice.sample ? livePrice.updatedAt : '',
      };
    }

    function validate(order: ReturnType<typeof collect>): Errors {
      const errors: Errors = {};
      if (!order.fillType) errors.fillType = 'Choose Fill to Full or an exact amount.';
      else if (order.fillType === 'fill' && !order.gallons && !fillUnknown.checked)
        errors.fillType = 'Enter about how many gallons it will take (e.g. 120), or tick “I don’t know”.';
      else if (order.fillType === 'exact' && (!order.gallons || order.gallons < min)) errors.fillType = `Minimum delivery is ${min} gallons.`;
      if (order.dateType !== 'asap') {
        if (!order.requestedDate) errors.date = 'Pick a date.';
        else if (order.requestedDate < isoToday()) errors.date = 'Pick a date from today on.';
        else if (isWeekend(order.requestedDate)) errors.date = 'We deliver Monday to Friday. Please pick a weekday.';
      }
      if (order.address.length < 5) errors.address = 'Tell us where your boat is docked.';
      if (!order.area) errors.area = 'Please choose your area.';
      if (order.name.length < 2) errors.name = 'Please enter your name.';
      if (!PHONE.test(order.phone) || order.phone.replace(/\D/g, '').length < 10) errors.phone = 'Please enter a mobile number we can text.';
      if (order.email && !EMAIL.test(order.email)) errors.email = 'That email address doesn’t look right.';
      if (order.termsAck.items.length < orderTerms.length) errors.terms = 'Please confirm each item before you submit.';
      return errors;
    }

    // Confirmation pop-up: opens after a successful send, closes with Done, X,
    // Escape or a click outside, and can be reopened from the note left in place of the form.
    function openConfirm() {
      if (!confirm) return;
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d !== confirm && d.close());
      if (!confirm.open) confirm.showModal();
      window.__lenis?.stop();
      track('booking_confirm_view', { placement: form.dataset.placement ?? '' });
    }
    confirm?.addEventListener('close', () => {
      window.__lenis?.start();
      sent?.scrollIntoView({ block: 'start' });
      sent?.focus({ preventScroll: true });
    });
    confirm?.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-confirm-close]') || event.target === confirm) confirm.close();
    });
    sent?.querySelector('[data-confirm-open]')?.addEventListener('click', openConfirm);

    function fillSummary(order: ReturnType<typeof collect>) {
      const set = (key: string, value: string) => {
        const target = root.querySelector<HTMLElement>(`[data-sum="${key}"]`);
        if (target) target.textContent = value;
      };
      const nameSlot = root.querySelector<HTMLElement>('[data-done-name]');
      if (nameSlot) nameSlot.textContent = order.firstName ? `, ${order.firstName}` : '';
      set('address', order.address);
      set(
        'amount',
        order.fillType === 'exact' ? `${order.gallons} gal` : order.gallons ? `Fill to full (about ${order.gallons} gal)` : 'Fill to full',
      );
      set(
        'date',
        order.dateType === 'asap'
          ? 'ASAP, soonest available'
          : order.dateType === 'before'
            ? `By ${prettyDate(order.requestedDate)}`
            : prettyDate(order.requestedDate),
      );
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !button) return;
      status.textContent = '';
      status.removeAttribute('data-tone');

      const order = collect();
      ['fillType', 'date', 'address', 'area', 'name', 'phone', 'email', 'terms'].forEach(clearError);
      const errors = validate(order);
      const names = Object.keys(errors);
      if (names.length) {
        names.forEach((name) => setError(name, errors[name]));
        fieldFor(names[0])?.focus();
        status.dataset.tone = 'error';
        status.textContent = names.length === 1 ? 'Please fix the highlighted item.' : `Please fix the ${names.length} highlighted items.`;
        return;
      }

      button.disabled = true;
      try {
        let ok = false;
        if (import.meta.env.DEV || import.meta.env.PUBLIC_DEMO === '1') {
          // Local development and the demo build have no CRM: log the order instead of sending it.
          console.info('[order form] would send', order);
          await new Promise((resolve) => setTimeout(resolve, 600));
          ok = true;
        } else {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify(order),
          });
          ok = response.ok;
        }
        if (!ok) throw new Error('rejected');

        track('booking_request_submit', { placement: order.placement, area: order.area, fill_type: order.fillType ?? '', date_type: order.dateType });
        try {
          localStorage.setItem('bf:booked', String(Date.now()));
        } catch {
          /* storage unavailable */
        }
        fillSummary(order);
        form.hidden = true;
        if (sent) sent.hidden = false;
        openConfirm();
      } catch {
        status.dataset.tone = 'error';
        status.innerHTML =
          'Something went wrong. Please try again, or call <a href="tel:+19417240453">(941) 724-0453</a>.';
        track('order_form_error', { placement: order.placement });
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
