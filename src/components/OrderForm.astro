---
/**
 * Our own fuel booking form. It follows the app's "Request Fuel" screen
 * (Blackfin_app app/(tabs)/book.tsx) so a website booking asks the same things
 * the app does: how much REC-90 (Fill to Full or an exact amount), when
 * (ASAP, by a date, or on an exact date, weekdays only), where the boat is and
 * what the driver is filling, then the same "Before you submit" checklist.
 *
 * Shows today's live price (from /api/price) and the estimated total
 * (price x gallons, delivery included). Posts JSON to /api/order
 * (functions/api/order.ts), which forwards it to the hub. Validates in the
 * browser and again on the server. The success screen points them to the app.
 *
 *   <OrderForm />
 *   <OrderForm title="Book your delivery" note="Takes about a minute." heading="h2" />
 *
 * id   Prefix for field ids. Change it if two forms ever sit on one page.
 */
import Icon from './Icon.astro';
import StoreBadges from './StoreBadges.astro';
import QrCode from './QrCode.astro';
import { app, contact, forms, orderAreas, orderTerms } from '../data/site';

interface Props {
  title?: string;
  note?: string;
  heading?: 'h2' | 'h3';
  id?: string;
  /** Short id of where the form sits, sent with the order and to analytics. */
  placement?: string;
  class?: string;
}

const { title, note, heading = 'h3', id = 'order', placement = 'page', class: className } = Astro.props;
const Heading = heading;
const f = (name: string) => `${id}-${name}`;
const min = forms.minGallons;
---

<div class:list={['oform', className]}>
  {
    (title || note) && (
      <div class="oform__head">
        {title && <Heading class="oform__title">{title}</Heading>}
        {note && <p class="oform__note">{note}</p>}
      </div>
    )
  }

  <form
    class="oform__form"
    action={forms.orderEndpoint}
    method="post"
    novalidate
    data-order-form
    data-placement={placement}
    data-min={min}
  >
    <fieldset class="oform__group">
      <legend class="oform__legend"><span class="numeral">01</span> How much REC-90?</legend>
      <div class="amount" role="radiogroup" aria-label="How much REC-90?" id={f('fillType')}>
        <label class="amount__card">
          <input type="radio" name="fillType" value="fill" />
          <span class="amount__title">Fill to Full</span>
          <span class="amount__sub" data-amount-sub="fill">we fill the tank</span>
        </label>
        <label class="amount__card">
          <input type="radio" name="fillType" value="exact" />
          <span class="amount__title">Exact amount</span>
          <span class="amount__sub" data-amount-sub="exact">not a fill</span>
        </label>
      </div>

      <div class="amount__panel" data-panel="fill" hidden>
        <label class="field__label" for={f('fillGuess')}>About how many gallons to fill it up? Your best guess is fine.</label>
        <div class="amount__row">
          <span class="unit-input">
            <input id={f('fillGuess')} name="fillGuess" type="number" inputmode="numeric" min="1" max="9999" step="1" placeholder="0" />
            <span aria-hidden="true">Gallons</span>
          </span>
          <label class="chip chip--check">
            <input type="checkbox" name="fillUnknown" value="yes" />
            <span>I don’t know</span>
          </label>
        </div>
      </div>

      <div class="amount__panel" data-panel="exact" hidden>
        <label class="field__label" for={f('exactGallons')}>Gallons</label>
        <div class="amount__row">
          <div class="stepper">
            <button type="button" data-step="-10" aria-label="10 gallons less"><Icon name="minus" size={18} /></button>
            <span class="unit-input">
              <input id={f('exactGallons')} name="exactGallons" type="number" inputmode="numeric" min={min} max="9999" step="1" value={min} />
              <span aria-hidden="true">Gallons</span>
            </span>
            <button type="button" data-step="10" aria-label="10 gallons more"><Icon name="plus" size={18} /></button>
          </div>
        </div>
        <p class="field__hint">We deliver exactly this many gallons, not a fill to full. Minimum {min} gallons.</p>
      </div>

      <p class="field__error" id={f('fillType-error')} hidden></p>
      <p class="field__hint oform__gap">Final amount is measured at the pump.</p>
    </fieldset>

    <fieldset class="oform__group">
      <legend class="oform__legend"><span class="numeral">02</span> When do you need fuel?</legend>
      <div class="when" role="radiogroup" aria-label="When do you need fuel?">
        <label class="when__card">
          <input type="radio" name="dateType" value="asap" checked />
          <span class="when__title">ASAP</span>
          <span class="when__sub">Soonest available. We’ll confirm your delivery day</span>
        </label>
        <label class="when__card">
          <input type="radio" name="dateType" value="before" />
          <span class="when__title">By a date</span>
          <span class="when__sub">Deliver by your chosen date, sooner is OK</span>
        </label>
        <label class="when__card">
          <input type="radio" name="dateType" value="on" />
          <span class="when__title">On an exact date</span>
          <span class="when__sub">Deliver on that day exactly</span>
        </label>
      </div>

      <p class="field__hint oform__gap" data-when-asap>No date needed. We’ll slot you onto the soonest route in your area and confirm your delivery day.</p>

      <div class="oform__grid oform__gap" data-when-date hidden>
        <div class="field">
          <label for={f('date')}>Date <span aria-hidden="true">*</span></label>
          <input id={f('date')} name="date" type="date" />
          <p class="field__hint">We deliver Monday to Friday.</p>
          <p class="field__error" id={f('date-error')} hidden></p>
        </div>
        <label class="check check--sooner" data-when-sooner hidden>
          <input type="checkbox" name="okSooner" value="yes" />
          <span>
            <strong>Sooner is OK if a route has room</strong>
            <small>If we have an opening before this day, we may come early.</small>
          </span>
        </label>
      </div>
    </fieldset>

    <fieldset class="oform__group">
      <legend class="oform__legend"><span class="numeral">03</span> Your boat</legend>
      <div class="oform__grid">
        <div class="field field--wide">
          <label for={f('address')}>Dock / home address <span aria-hidden="true">*</span></label>
          <input
            id={f('address')}
            name="address"
            type="text"
            autocomplete="street-address"
            required
            maxlength="200"
            placeholder="Street, city and ZIP of the dock"
          />
          <p class="field__error" id={f('address-error')} hidden></p>
        </div>
        <div class="field">
          <label for={f('area')}>Area <span aria-hidden="true">*</span></label>
          <div class="field__select">
            <select id={f('area')} name="area" required>
              <option value="">Choose your area</option>
              {orderAreas.map((area) => <option value={area}>{area}</option>)}
            </select>
            <Icon name="chevron-down" size={18} />
          </div>
          <p class="field__error" id={f('area-error')} hidden></p>
        </div>
        <div class="field">
          <span class="field__label" id={f('boatType-label')}>Type</span>
          <div class="segmented" role="radiogroup" aria-labelledby={f('boatType-label')}>
            <label><input type="radio" name="boatType" value="Boat" checked /><span>Boat</span></label>
            <label><input type="radio" name="boatType" value="Jet ski" /><span>Jet ski</span></label>
            <label><input type="radio" name="boatType" value="Other" /><span>Other</span></label>
          </div>
        </div>
        <div class="field">
          <span class="field__label" id={f('tanks-label')}>Number of fuel tanks</span>
          <div class="segmented segmented--4" role="radiogroup" aria-labelledby={f('tanks-label')}>
            <label><input type="radio" name="tanks" value="1" checked /><span>1</span></label>
            <label><input type="radio" name="tanks" value="2" /><span>2</span></label>
            <label><input type="radio" name="tanks" value="3" /><span>3</span></label>
            <label><input type="radio" name="tanks" value="4" /><span>4+</span></label>
          </div>
        </div>
        <div class="field">
          <label for={f('tankGallons')}>Tank size <span class="field__opt">(gallons, all tanks together)</span></label>
          <input id={f('tankGallons')} name="tankGallons" type="number" inputmode="numeric" min="1" max="9999" step="1" placeholder="e.g. 150" />
        </div>
        <div class="field field--wide">
          <label for={f('boatName')}>Boat name <span class="field__opt">(optional)</span></label>
          <input id={f('boatName')} name="boatName" type="text" maxlength="120" placeholder="Name, make or length" />
        </div>
      </div>
    </fieldset>

    <fieldset class="oform__group">
      <legend class="oform__legend"><span class="numeral">04</span> Your details</legend>
      <div class="oform__grid">
        <div class="field">
          <label for={f('name')}>Full name <span aria-hidden="true">*</span></label>
          <input id={f('name')} name="name" type="text" autocomplete="name" required maxlength="120" />
          <p class="field__error" id={f('name-error')} hidden></p>
        </div>
        <div class="field">
          <label for={f('phone')}>Mobile number <span aria-hidden="true">*</span></label>
          <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="30" placeholder="(941) 555-0123" />
          <p class="field__hint">We text you here to confirm your delivery day.</p>
          <p class="field__error" id={f('phone-error')} hidden></p>
        </div>
        <div class="field field--wide">
          <label for={f('email')}>Email <span class="field__opt">(optional)</span></label>
          <input id={f('email')} name="email" type="email" autocomplete="email" maxlength="160" />
          <p class="field__error" id={f('email-error')} hidden></p>
        </div>
        <div class="field field--wide">
          <label for={f('notes')}>Notes <span class="field__opt">(optional)</span></label>
          <textarea id={f('notes')} name="notes" rows="2" maxlength="1000" placeholder="Gate code, access notes, anything the crew should know…"></textarea>
        </div>
      </div>
    </fieldset>

    <div class="quote" data-price-block hidden>
      <div class="quote__cell">
        <span class="quote__label">Today’s REC-90 price</span>
        <span class="quote__value numeral"><span data-price>…</span><small>/gal</small></span>
        <span class="quote__meta" data-price-updated></span>
      </div>
      <div class="quote__cell quote__cell--total">
        <span class="quote__label">Estimated total</span>
        <span class="quote__value numeral" data-total aria-live="polite">Choose an amount</span>
        <span class="quote__meta">Final price measured at the pump · $0 delivery fee</span>
      </div>
    </div>
    <p class="field__hint" data-price-missing>Today’s price is confirmed by text before your delivery.</p>

    <fieldset class="oform__group terms" id={f('terms')}>
      <legend class="oform__legend">Before you submit</legend>
      <p class="terms__sub" data-terms-sub>Please confirm each item below.</p>
      <ul class="terms__list">
        {
          orderTerms.map((item, i) => (
            <li>
              <label class="check">
                <input type="checkbox" name="terms" value={String(i)} />
                <span>{item}</span>
              </label>
            </li>
          ))
        }
      </ul>
      <p class="field__error" id={f('terms-error')} hidden></p>
    </fieldset>

    <!-- Spam trap: people never see or fill this. -->
    <div class="oform__trap" aria-hidden="true">
      <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="oform__submit">
      <button class="oform__button" type="submit">
        <span class="oform__button-label">Confirm request</span>
        <span class="oform__spinner" aria-hidden="true"></span>
        <Icon name="arrow-right" size={18} class="oform__arrow" />
      </button>
      <p class="oform__legal">
        No payment now. We review your request and text to confirm your delivery day, then you can track it and pay the invoice in the
        app. By sending this you agree that we may call or text you about your delivery.
      </p>
    </div>
    <p class="oform__status" role="status" aria-live="polite" data-form-status></p>
  </form>

  <div class="oform__sent" data-form-sent hidden tabindex="-1">
    <span class="oform__sent-icon"><Icon name="check" size={22} /></span>
    <div>
      <p class="oform__sent-title">Order received.</p>
      <p>We’ll text you to confirm your delivery day. <button type="button" class="oform__sent-link" data-confirm-open>See your order</button></p>
    </div>
  </div>

  <dialog class="oconfirm" data-order-confirm aria-labelledby={f('confirm-title')} closedby="any" data-lenis-prevent>
    <div class="oconfirm__panel">
      <button class="oconfirm__close" type="button" data-confirm-close aria-label="Close">
        <Icon name="close" size={20} />
      </button>

      <div class="oconfirm__badge" aria-hidden="true" data-float-open>
        <span class="oconfirm__ring"></span>
        <span class="oconfirm__ring oconfirm__ring--2"></span>
        <svg viewBox="0 0 80 80" class="oconfirm__mark">
          <circle class="oconfirm__circle" cx="40" cy="40" r="36"></circle>
          <path class="oconfirm__tick" d="M25 41.5 35 51.5 56 30"></path>
        </svg>
      </div>

      <div class="oconfirm__body">
        <p class="eyebrow">Order received</p>
        <h2 class="oconfirm__title" id={f('confirm-title')}>Thanks<span data-done-name></span>! We received your order.</h2>
        <span class="oform__pill">Pending confirmation</span>
        <p class="oconfirm__lede">Blackfin Fuels will review it and text you to confirm your delivery day.</p>

        <div class="oconfirm__app">
          <p class="oconfirm__app-title"><Icon name="smartphone" size={20} /> To track your order, please download our app</p>
          <p>Sign in with the same mobile number to follow your delivery and pay your invoice.</p>
          <div class="oform__app-get">
            <QrCode source="booking-done" size={96} class="oform__qr" />
            <StoreBadges placement="booking-done" size="md" adaptive align="center" />
          </div>
          <p class="oconfirm__ref"><Icon name="gift" size={16} /> {app.referral.terms} New Blackfin customers only.</p>
        </div>

        <dl class="oform__summary">
          <div><dt>Delivery location</dt><dd data-sum="address"></dd></div>
          <div><dt>Fuel type</dt><dd>REC-90</dd></div>
          <div><dt>Fuel quantity</dt><dd data-sum="amount"></dd></div>
          <div><dt>Delivery date</dt><dd data-sum="date"></dd></div>
        </dl>

        <div class="oconfirm__foot">
          <button class="oconfirm__done" type="button" data-confirm-close>Done</button>
          <a href={contact.phoneHref}><Icon name="phone" size={16} /> {contact.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </dialog>
</div>

<style>
  /* The booking form never moves. It glows instead: a soft halo plus a light
     that slowly travels round its border. Reduced motion keeps a still glow. */
  @property --oform-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .oform {
    isolation: isolate;
    box-shadow:
      0 0 0 1px rgb(95 175 255 / 0.35),
      0 30px 80px -30px rgb(0 0 0 / 0.8),
      0 0 70px -12px rgb(95 175 255 / 0.4);
  }

  .oform::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 1;
    padding: 2px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--oform-angle),
      transparent 0deg,
      transparent 200deg,
      rgb(95 175 255 / 0.85) 260deg,
      rgb(255 255 255 / 0.95) 285deg,
      rgb(95 175 255 / 0.85) 310deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  .oform::after {
    content: '';
    position: absolute;
    inset: -2.5rem;
    z-index: -1;
    border-radius: calc(var(--radius-lg) + 2.5rem);
    background: radial-gradient(closest-side, rgb(95 175 255 / 0.28), transparent);
    filter: blur(20px);
    opacity: 0.7;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .oform::before {
      animation: oform-orbit 7s linear infinite;
    }

    .oform::after {
      animation: oform-breathe 4.5s ease-in-out infinite;
    }
  }

  @keyframes oform-orbit {
    to {
      --oform-angle: 360deg;
    }
  }

  @keyframes oform-breathe {
    50% {
      opacity: 1;
      transform: scale(1.03);
    }
  }

  :global(.tone-light) .oform {
    box-shadow:
      0 0 0 1px rgb(55 138 221 / 0.35),
      0 30px 70px -30px rgb(12 30 47 / 0.35),
      0 0 60px -12px rgb(95 175 255 / 0.45);
  }

  .oform__gap {
    margin-top: 0.45rem;
  }


  /* inline note left in place of the form after sending */
  .oform__sent {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    color: var(--text-muted);
    background: rgb(95 175 255 / 0.08);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    outline: none;
    scroll-margin-top: 6rem;
  }

  .oform__sent[hidden] {
    display: none;
  }

  .oform__sent-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 50%;
  }

  .oform__sent-title {
    font-weight: 700;
    color: var(--text);
  }

  .oform__sent-link {
    font-weight: 700;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* confirmation pop-up */
  .oconfirm {
    width: min(100% - 1.5rem, 34rem);
    max-width: none;
    max-height: min(100dvh - 1.5rem, 54rem);
    margin: auto;
    padding: 0;
    overflow: visible;
    color: var(--text-muted);
    background: transparent;
    border: 0;
  }

  .oconfirm::backdrop {
    background: rgb(4 11 18 / 0.7);
    backdrop-filter: blur(6px);
  }

  .oconfirm__panel {
    position: relative;
    max-height: inherit;
    overflow-y: auto;
    padding: clamp(1.4rem, 1rem + 1.6vw, 2.2rem);
    text-align: center;
    background:
      radial-gradient(90% 50% at 50% 0%, rgb(95 175 255 / 0.28), transparent 70%),
      linear-gradient(165deg, #10304f, var(--navy-800) 60%, var(--navy-900));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.9);
  }

  .oconfirm__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .oconfirm__close:hover {
    color: var(--on-accent);
    background: var(--accent);
  }

  .oconfirm__badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 6rem;
    height: 6rem;
    margin: 0.5rem auto 1.25rem;
  }

  .oconfirm__mark {
    position: relative;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .oconfirm__circle {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 3;
  }

  .oconfirm__tick {
    stroke: var(--on-accent);
    stroke-width: 6;
  }

  .oconfirm__ring {
    position: absolute;
    inset: 0;
    border: 2px solid var(--accent);
    border-radius: 50%;
    opacity: 0;
  }

  .oconfirm__body {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
  }

  .oconfirm__title {
    font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.4rem);
    line-height: 1.05;
    color: var(--text);
  }

  .oconfirm__lede {
    max-width: 26rem;
  }

  .oconfirm .oform__summary {
    text-align: left;
  }

  .oconfirm__app {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 1.25rem;
    background: rgb(95 175 255 / 0.1);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
  }

  .oconfirm__app-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--text);
  }

  .oconfirm__app-title :global(.icon),
  .oconfirm__ref :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  .oconfirm__app p:not(.oconfirm__app-title) {
    font-size: var(--step--1);
  }

  .oconfirm__app .oform__app-get {
    justify-content: center;
    margin-top: 0.3rem;
  }

  .oconfirm__ref {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.45rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .oconfirm__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.25rem;
  }

  .oconfirm__done {
    min-height: 3.2rem;
    padding: 0.8rem 2.4rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: var(--radius);
  }

  .oconfirm__done:hover {
    background: var(--accent-strong);
  }

  .oconfirm__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
  }

  .oconfirm__foot a :global(.icon) {
    color: var(--accent);
  }

  /* Animation: the panel pops in, the circle and tick draw, rings ripple out,
     then the content rises in. Skipped for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .oconfirm[open] .oconfirm__panel {
      animation: oconfirm-pop 0.55s cubic-bezier(0.2, 1.3, 0.4, 1) both;
    }

    .oconfirm[open]::backdrop {
      animation: oconfirm-fade 0.3s ease both;
    }

    .oconfirm[open] .oconfirm__circle {
      stroke-dasharray: 227;
      animation:
        oconfirm-circle 0.6s 0.2s ease-out both,
        oconfirm-fill 0.3s 0.7s ease-out both;
    }

    .oconfirm[open] .oconfirm__tick {
      stroke-dasharray: 48;
      animation: oconfirm-tick 0.4s 0.85s ease-out both;
    }

    .oconfirm[open] .oconfirm__mark {
      animation: oconfirm-bump 0.45s 0.8s ease-out both;
    }

    .oconfirm[open] .oconfirm__ring {
      animation: oconfirm-ripple 1.4s 0.9s ease-out both;
    }

    .oconfirm[open] .oconfirm__ring--2 {
