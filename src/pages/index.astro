<script>
  // Customer reviews: the client's Trustindex widget, loaded only when the
  // section is about to scroll into view.
  const box = document.querySelector<HTMLElement>('[data-reviews]');
  if (box && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        const script = document.createElement('script');
        script.src = box.dataset.src ?? '';
        script.async = true;
        script.addEventListener('load', () => box.setAttribute('data-loaded', ''));
        box.append(script);
      },
      { rootMargin: '700px 0px' },
    );
    observer.observe(box);
  }
</script>
