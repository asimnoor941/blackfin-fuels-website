---
/**
 * /faqs/ : every question from the live page, word for word, grouped by topic.
 * Drawn in the home page's language: big Anton hero with the photo standing up
 * on scroll, a sticky topic index beside hairline-ruled question rows, and
 * contact cards that hinge up as they scroll in.
 * Copy: reference/original-site/content/faqs.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import type { FaqItem } from '../components/Faq.astro';
import ContactMethods from '../components/support/ContactMethods.astro';
import SupportHero from '../components/support/SupportHero.astro';
import { contact, ORDER_URL } from '../data/site';

import heroPhoto from '../assets/photos/fueling-boat-lift.jpg';

// Every question and answer from the live page, word for word, grouped by topic.
const groups: { id: string; title: string; items: FaqItem[] }[] = [
  {
    id: 'the-fuel',
    title: 'The Fuel',
    items: [
      {
        q: 'What kind of marine fuel do you deliver?',
        a: 'We currently deliver REC-90 non-ethanol marine gasoline.',
      },
      {
        q: 'Do you add additives to the fuel?',
        a: 'No. We do not add any additives. It is Fresh Fuel. It comes directly from our distributor’s tank to our tank to your boat!',
      },
      {
        q: 'Do you offer diesel fuel?',
        a: 'Unfortunately, we do not offer diesel fuel at this time, check back with us!',
      },
      {
        q: 'Do you serve any industries other than marine?',
        a: 'We do deliver to a variety of customers for uses other than boating, i.e. generators, and onsite stand-alone tanks for communities.',
      },
    ],
  },
  {
    id: 'delivery',
    title: 'Delivery',
    items: [
      {
        q: 'Can I request my marine fuel be delivered at a specific time?',
        a: 'We will do our best to accommodate your preference for either AM or PM delivery. You don’t need to be present during fill-up.',
      },
      {
        q: 'Do I need to be present when you are fueling?',
        a: 'No, you don’t need to be there when we are fueling as long as we have access to your vessel, and a lifted panel if needed to lower for refueling. We can send an invoice via email so you will know as soon as delivery has taken place.',
      },
      {
        q: 'How long are your fueling hoses?',
        a: 'Our truck has a 350 foot fueling hose that allows us to park on the street and reach most docks with ease.',
      },
    ],
  },
  {
    id: 'pricing-and-payment',
    title: 'Pricing &amp; Payment',
    items: [
      {
        q: 'Do marine fuel prices change frequently?',
        a: 'Fuel prices fluctuate daily so keep that in mind when scheduling services out.',
      },
      {
        q: 'Do you offer competitive pricing?',
        a: 'Yes! We are typically less expensive than the marinas.',
      },
      {
        q: 'Is there a minimum purchase requirement?',
        a: 'Yes, the minimum purchase requirement varies by location. Reach out to learn more!',
      },
      {
        q: 'Do you offer any discounts?',
        a: 'We offer 10 cents off per gal for 100+ gal delivered, and also 10 cents off per gal for Military. Offers can be combined!',
      },
      {
        q: 'How do I pay?',
        a: 'We have a variety of payment options available. Including cash, Zelle, check, ACH (bank transfer) or debit/credit card (2.9% Merchant fee applies). You will receive an emailed invoice for ACH and/or card payment.',
      },
    ],
  },
];

// One FAQPage object for the whole page.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups
    .flatMap((group) => group.items)
    .map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
};

const pad = (n: number) => String(n).padStart(2, '0');
// Running question number across the groups (Q01 to Q12).
const offsets = groups.map((_, i) => groups.slice(0, i).reduce((sum, g) => sum + g.items.length, 0));
const total = groups.reduce((sum, g) => sum + g.items.length, 0);
---

<BaseLayout
  title="FAQs: Marine Fuel Delivery Questions Answered"
  description="Answers on our REC-90 non-ethanol marine fuel delivery: the 350 foot hose, AM or PM delivery, payment options, minimum purchase and discounts."
  breadcrumbs={[{ name: 'FAQs', href: '/faqs/' }]}
  jsonLd={faqSchema}
>
  <!-- ============ HERO ============ -->
  <SupportHero
    eyebrow="FAQs"
    title="Have Questions?"
    lede="The fuel, the delivery and how pricing and payment work, answered in plain terms."
  >
    <Button href={ORDER_URL} size="lg">Order Fuel</Button>
    <Button href="/contact-us/" variant="ghost" size="lg" arrow={false}>Contact Us</Button>

    <nav slot="meta" class="topics" aria-label="FAQ topics">
      <ol class="topics__list" role="list">
        {
          groups.map((group, i) => (
            <li>
              <a class="topics__link" href={`#${group.id}`}>
                <span class="topics__num numeral" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <span class="topics__label" set:html={group.title} />
                <span class="topics__count">
                  {group.items.length} questions
                </span>
                <Icon name="arrow-down" size={18} />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <Photo
      slot="media"
      src={heroPhoto}
      alt="Blackfin Fuels technician in a sun hat fueling a boat on a lift with a red fuel nozzle"
      ratio="21 / 8"
      position="70% 38%"
      sizes="(min-width: 80em) 77rem, 94vw"
      reveal={false}
      eager
      class="hero-photo"
    />
  </SupportHero>

  <!-- ============ QUESTIONS ============ -->
  <section class="qa" aria-label="Questions and answers">
    <div class="container qa__grid">
      <aside class="qa__aside" data-reveal>
        <p class="eyebrow">{total} Answers</p>
        <p class="qa__statement">Straight answers, <span class="accent">grouped by topic.</span></p>
        <ol class="qa__index" role="list">
          {
            groups.map((group, i) => (
              <li>
                <a href={`#${group.id}`}>
                  <span class="numeral">{pad(i + 1)}</span>
                  <span set:html={group.title} />
                </a>
              </li>
            ))
          }
        </ol>
        <div class="qa__ask">
          <p><strong>Still have a question?</strong> Call or text and we’ll answer it.</p>
          <a class="qa__phone" href={contact.phoneHref}>
            <Icon name="phone" size={18} />
            <span>{contact.phoneDisplay}</span>
          </a>
        </div>
      </aside>

      <div class="qa__groups">
        {
          groups.map((group, i) => (
            <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
              <header class="group__head">
                <span class="group__index numeral" aria-hidden="true" data-3d="pop">
                  {pad(i + 1)}
                </span>
                <div class="group__titles" data-reveal>
                  <p class="group__count">
                    {group.items.length} questions
                  </p>
                  <h2 class="group__title" id={`${group.id}-title`} set:html={group.title} />
                </div>
              </header>

              <div class="group__list">
                {group.items.map((item, j) => (
                  <details class="qrow">
                    <summary class="qrow__q">
                      <span class="qrow__num">Q{pad(offsets[i] + j + 1)}</span>
                      <span class="qrow__text">{item.q}</span>
                      <span class="qrow__mark" aria-hidden="true" />
                    </summary>
                    <div class="qrow__a">
                      <p set:html={item.a} />
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="reach">
    <div class="container">
      <header class="head head--split">
        <div data-reveal>
          <p class="eyebrow">Get In Touch</p>
          <h2>Contact Our Team</h2>
        </div>
        <p class="lede" data-reveal>Reach out and we'll get you scheduled.</p>
      </header>
      <ContactMethods layout="cards" flip />
    </div>
  </section>

  <CtaBand title="Ready to Get<br />Fueled Up?" text="Tell us where you are. We’ll handle the rest.">
    <Button href={ORDER_URL} size="lg">Order Fuel</Button>
  </CtaBand>
</BaseLayout>

<style>
  section {
    position: relative;
    z-index: var(--z-content);
  }

  .head {
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .head > div > :global(* + *) {
    margin-top: 1.1rem;
  }

  @media (min-width: 60em) {
    .head--split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }
  }

  @media (max-width: 59.99em) {
    .head--split > :global(.lede) {
      margin-top: 1.25rem;
    }
  }

  /* ---------- hero topic row ---------- */
  .topics__list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 48em) {
    .topics__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .topics__list li + li .topics__link {
      border-left: 1px solid var(--line);
    }
  }

  .topics__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'num label icon'
      'num count icon';
    align-items: center;
    column-gap: 1rem;
    min-height: 4.5rem;
    padding: 1rem clamp(0.25rem, 0.2rem + 1vw, 1.5rem);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .topics__num {
    grid-area: num;
    font-size: var(--step-3);
    color: var(--accent);
  }

  .topics__label {
    grid-area: label;
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .topics__count {
    grid-area: count;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .topics__link :global(.icon) {
    grid-area: icon;
    color: var(--text-faint);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .topics__link:hover,
  .topics__link:focus-visible {
    background: rgb(95 175 255 / 0.06);
  }

  .topics__link:hover :global(.icon),
  .topics__link:focus-visible :global(.icon) {
    color: var(--accent);
    transform: translateY(3px);
  }

  /* ---------- questions ---------- */
  .qa {
    padding-block: var(--section-pad);
    background:
      radial-gradient(60% 40% at 90% 10%, rgb(55 138 221 / 0.12), transparent 70%),
      linear-gradient(180deg, var(--navy-800), var(--navy-900));
    border-bottom: 1px solid var(--line);
  }

  .qa__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 62em) {
    .qa__grid {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: 5rem;
      align-items: start;
    }
    .qa__aside {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
  }

  @media (min-width: 62em) and (max-height: 44rem) {
    .qa__aside {
      position: static;
    }
  }

  .qa__aside > :global(* + *) {
    margin-top: 1.4rem;
  }

  .qa__statement {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 0.98;
    text-transform: uppercase;
  }

  .qa__statement :global(.accent) {
    color: var(--accent);
  }

  .qa__index {
    margin-top: 2.25rem !important;
    border-top: 1px solid var(--line-strong);
  }

  @media (max-width: 61.99em) {
    .qa__index {
      display: none;
    }
  }

  .qa__index a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition: color var(--dur-2) var(--ease-out);
  }

  .qa__index .numeral {
    color: var(--accent);
  }

  .qa__index a:hover,
  .qa__index a:focus-visible {
    color: var(--accent);
  }

  .qa__ask {
    display: grid;
    gap: 0.9rem;
    margin-top: 2.25rem !important;
    padding: 1.4rem;
    background: linear-gradient(170deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015)), var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
  }

  .qa__ask p {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .qa__ask strong {
    display: block;
    margin-bottom: 0.2rem;
    font-size: var(--step-0);
    color: var(--text);
  }

  .qa__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--text);
  }

  .qa__phone :global(.icon) {
    color: var(--accent);
  }

  .qa__phone:hover {
    color: var(--accent);
  }

  .qa__groups {
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 7rem);
    min-width: 0;
  }

  .group {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .group__head {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(6rem, 4rem + 7vw, 10rem);
    margin-bottom: 1.5rem;
    perspective: 1400px;
  }

  .group__index {
    position: absolute;
    right: 0;
    bottom: -0.08em;
    font-size: clamp(4.92rem, 2.25rem + 6.8vw, 8.4rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    pointer-events: none;
  }

  .group__titles {
    position: relative;
  }

  .group__count {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .group__title {
    margin-top: 0.6rem;
    font-size: var(--step-4);
    line-height: 0.95;
  }

  .group__list {
    border-top: 1px solid var(--line-strong);
  }

  .qrow {
    border-bottom: 1px solid var(--line-strong);
  }

  .qrow__q {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: clamp(0.6rem, 0.4rem + 1vw, 1.25rem);
    min-height: 4.75rem;
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .qrow__q::-webkit-details-marker {
    display: none;
  }

  .qrow__num {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .qrow__text {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .qrow__mark {
    position: relative;
    justify-self: end;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .qrow__mark::before,
  .qrow__mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.85rem;
    height: 1.5px;
    background: var(--accent);
    transform: translate(-50%, -50%);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .qrow__mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .qrow[open] .qrow__mark {
    background: var(--accent);
    border-color: var(--accent);
  }

  .qrow[open] .qrow__mark::before,
  .qrow[open] .qrow__mark::after {
    background: var(--on-accent);
  }

  .qrow[open] .qrow__mark::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .qrow__q:hover .qrow__text,
  .qrow[open] .qrow__text {
    color: var(--accent-strong);
  }

  .qrow__q:hover .qrow__mark {
    border-color: var(--accent);
  }

  .qrow__a {
    padding: 0 0 1.6rem calc(3.25rem + clamp(0.6rem, 0.4rem + 1vw, 1.25rem));
    max-width: 44em;
    color: var(--text-muted);
    line-height: 1.75;
  }

  @media (max-width: 30em) {
    .qrow__q {
      grid-template-columns: minmax(0, 1fr) 2.75rem;
    }
    .qrow__num {
      grid-column: 1 / -1;
    }
    .qrow__a {
      padding-left: 0;
    }
  }

  /* ---------- contact ---------- */
  .reach {
    padding-block: var(--section-pad);
    background: linear-gradient(180deg, var(--ink), var(--abyss));
  }

  @media (prefers-reduced-motion: reduce) {
    .qrow__mark,
    .qrow__mark::before,
    .qrow__mark::after,
    .topics__link :global(.icon) {
      transition: none;
    }
  }
</style>
